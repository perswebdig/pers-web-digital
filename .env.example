# ═════════════════════════════════════════════════════════════════════
# Pers Web Digital — variáveis de ambiente
# Copie para .env.local em desenvolvimento e configure no projeto da Vercel
# (Settings → Environment Variables) antes do go-live.
# ═════════════════════════════════════════════════════════════════════

# --- Identidade do site (Next.js / SEO) ------------------------------
# URL absoluta de produção. Alimenta canonical, sitemap, robots e Open Graph.
NEXT_PUBLIC_SITE_URL=https://perswebdigital.com.br

# --- Rastreamento e anúncios (opcional; sem ID nada é carregado) -----
# Google Analytics 4 — formato G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=
# Google Tag Manager — formato GTM-XXXXXX
NEXT_PUBLIC_GTM_ID=
# Meta (Facebook/Instagram) Pixel
NEXT_PUBLIC_META_PIXEL_ID=
# Verificação do Google Search Console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Captura de leads -------------------------------------------------
# Webhook de destino do formulário: n8n, Make, Zapier, Google Apps Script,
# RD Station ou endpoint próprio do CRM.
LEAD_WEBHOOK_URL=
# Remetente usado nas integrações de e-mail (precisa de domínio verificado)
LEAD_FROM_EMAIL="Pers Web Digital <site@perswebdigital.com.br>"
# E-mail do comercial que recebe a notificação de cada novo lead
LEAD_NOTIFY_EMAIL=

# --- Integrações opcionais -------------------------------------------
# HubSpot (CRM): private app token + portal ID
HUBSPOT_API_KEY=
HUBSPOT_PORTAL_ID=
# Resend (envio de e-mail transacional)
RESEND_API_KEY=

# --- Agendamento ------------------------------------------------------
# Calendly / Google Appointment Links para "Agende uma conversa"
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/perswebdigital/diagnostico

# --- Contatos e dados cadastrais -------------------------------------
# Alternativa às constantes de src/lib/site.ts (use um dos dois, não os dois)
NEXT_PUBLIC_WHATSAPP=5511999990000
NEXT_PUBLIC_PHONE=+551140000000
NEXT_PUBLIC_EMAIL=contato@perswebdigital.com.br
